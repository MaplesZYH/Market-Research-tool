# GitHub API
GITHUB_TOKEN=
GITHUB_FETCH_README=true
GITHUB_README_MAX_CHARS=20000

# Local Laya Python process
LAYA_URL=http://127.0.0.1:8001
LAYA_TIMEOUT_MS=30000
LAYA_INPUT_TOKEN_BUDGET=700

# AI API: configure your provider and protocol here
AI_API_BASE_URL=
AI_API_KEY=
AI_API_MODEL=
AI_API_CHAT_PATH=/v1/chat/completions
AI_API_TIMEOUT_MS=60000

# Application
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/github_market_scanner
PORT=3000
NODE_ENV=development
